# Node/Colyseus service. Configure these in the game-server host, never in the browser build.
NODE_ENV=production
PORT=2567
GAME_SERVER_HOST=0.0.0.0
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
CRAFTY_AUTH_SECRET=generate-a-long-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=https://your-game.chatgpt.site

# Sites frontend build. This is intentionally public and must point at the game server.
NEXT_PUBLIC_GAME_SERVER_URL=wss://game-server.example.com
