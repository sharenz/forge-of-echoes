{
  "name": "forge-of-echoes",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "server": "tsx src/server/main.ts",
    "debug_merch": "node --import tsx src/server/debug-merch-cli.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "layout:lint": "node scripts/layout-lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "shot": "node scripts/shot.mjs",
    "deploy:setup": "bash scripts/deploy/setup-prod.sh",
    "deploy": "bash scripts/deploy/deploy.sh"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "preact": "^10.29.8",
    "ws": "^8.22.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
